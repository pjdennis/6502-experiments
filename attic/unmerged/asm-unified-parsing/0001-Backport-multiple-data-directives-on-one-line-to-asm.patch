From 3f4ef7a934833b8ef69108e2ade831a613c8f032 Mon Sep 17 00:00:00 2001
From: Phil Dennis <pjdennis@gmail.com>
Date: Tue, 10 Feb 2026 07:05:23 -0600
Subject: [PATCH 01/16] Backport multiple data directives on one line to asm22

Allow chaining .byte, .word, and .asciiz directives on a single line,
e.g. `.byte $42 .word $1234` or `.byte .word` in .zeropage. Also adds
err_operand_in_zeropage to reject operands on .byte/.word in .zeropage.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 assembler2/22/asm.asm             |  32 +++++---
 assembler2/22/errors.asm          |   5 ++
 assembler2/22/tests/asm_tests.txt | 131 ++++++++++++++++++++++++++++--
 3 files changed, 148 insertions(+), 20 deletions(-)

diff --git a/assembler2/22/asm.asm b/assembler2/22/asm.asm
index 7d964a9..0c659f8 100644
--- a/assembler2/22/asm.asm
+++ b/assembler2/22/asm.asm
@@ -1554,8 +1554,12 @@ process_directive:
   ; A = mode (1=byte, 2=word)
   STA DATA_MODE
   JSR check_for_end_of_line
-  BCC .zp_has_operand       ; Not EOL — has operand, use normal path
-  ; Operand-less: emit dummy bytes (1 for .byte, 2 for .word)
+  BCS .zp_allocate          ; EOL — operand-less form
+  CMP #'.'
+  BEQ .zp_allocate          ; Another directive follows — operand-less form
+  JMP err_operand_in_zeropage
+.zp_allocate:
+  ; Emit dummy bytes (1 for .byte, 2 for .word)
   LDA #$00
   JSR emit                  ; Advance ZP PC by 1
   LDA DATA_MODE
@@ -1564,11 +1568,7 @@ process_directive:
   LDA #$00
   JSR emit                  ; Advance ZP PC by 2nd byte for .word
 .zp_done:
-  LDA #$FF
-  STA DATA_MODE             ; Reset DATA_MODE (same as set_data_mode exit)
   RTS
-.zp_has_operand:
-  JMP data_parameters_loop  ; Continue with normal value parsing
 
 
 handle_include:
@@ -1674,7 +1674,15 @@ data_parameters_loop:
   LDA #$00
   JSR emit
 .data_check_more:
-  JSR skip_optional_comma
+  JSR skip_spaces
+  CMP #','
+  BNE .data_not_comma
+  JSR read_char            ; Skip comma
+  JSR skip_spaces
+  JMP data_parameters_loop
+.data_not_comma:
+  CMP #'.'
+  BEQ .data_done           ; Another directive follows — return to caller
   JMP data_parameters_loop
 .data_value:
   JSR parse_value        ; C=1 for 2-byte, C=0 for 1-byte
@@ -1685,8 +1693,7 @@ data_parameters_loop:
 .data_emit_one_byte:
   LDA OPERAND16
   JSR emit
-  JSR skip_optional_comma
-  JMP data_parameters_loop
+  JMP .data_check_more
 .forced_width:
   CMP #$02
   BEQ .data_emit_two_bytes  ; Mode 2 (.word): force 2 bytes
@@ -1703,8 +1710,7 @@ data_parameters_loop:
   JSR emit
   LDA OPERAND16+$01      ; Emit high byte
   JSR emit
-  JSR skip_optional_comma
-  JMP data_parameters_loop
+  JMP .data_check_more
 .data_done:
   LDA #$FF
   STA DATA_MODE       ; Reset: allow spaced << >> outside .data
@@ -2342,8 +2348,12 @@ assemble_code:
   CMP #'.'
   BNE .opcode
 ; Directive
+.directive:
   JSR read_char
   JSR process_directive
+  LDA CURR_CHAR
+  CMP #'.'
+  BEQ .directive            ; Another directive on same line
   JMP .line_loop
 .opcode:
   ; Read mnemonic and look up in instruction table
diff --git a/assembler2/22/errors.asm b/assembler2/22/errors.asm
index 36f0c08..84e7acf 100644
--- a/assembler2/22/errors.asm
+++ b/assembler2/22/errors.asm
@@ -170,6 +170,11 @@ err_file_not_found:
   BRK
   .data $24 "File not found" $00
 
+; --- Zeropage directive errors ($25) ---
+err_operand_in_zeropage:
+  BRK
+  .data $25 "Operand not allowed on .byte/.word in .zeropage" $00
+
 ; --- Command line/usage errors ($F0-$F1) ---
 err_usage:
   BRK
diff --git a/assembler2/22/tests/asm_tests.txt b/assembler2/22/tests/asm_tests.txt
index ce292ba..f62c247 100644
--- a/assembler2/22/tests/asm_tests.txt
+++ b/assembler2/22/tests/asm_tests.txt
@@ -3634,20 +3634,18 @@ EXPECT_HEX: a5 00 a5 02
 
 ---
 NAME: zeropage_mixed_no_operand
-DESCRIPTION: Mix of operand-less and with-operand .byte/.word in .zeropage
+DESCRIPTION: Operand on .byte in .zeropage triggers error
 INPUT:
  1:   .zeropage
  2: a .byte
  3: b .word
  4: c .byte 0
- 5: d .word 0
- 6:   .code
- 7: * = $0200
- 8:   LDA a
- 9:   LDA b
-10:   LDA c
-11:   LDA d
-EXPECT_HEX: a5 00 a5 01 a5 03 a5 04
+ 5:   .code
+ 6: * = $0200
+ 7:   NOP
+EXPECT_ERROR: 37
+EXPECT_LINE: 4
+EXPECT_MSG: Operand not allowed on .byte/.word in .zeropage
 
 ---
 NAME: zeropage_byte_no_operand_last
@@ -3767,3 +3765,118 @@ INPUT:
 EXPECT_ERROR: 35
 EXPECT_LINE: 3
 EXPECT_MSG: Zero page overflow
+
+# --- Multiple directives on one line ---
+
+---
+NAME: multi_dir_asciiz_word
+DESCRIPTION: .asciiz followed by .word on same line
+INPUT:
+ 1: * = $0200
+ 2:   .asciiz "Hello" .word $1321
+EXPECT_HEX: 48 65 6c 6c 6f 00 21 13
+
+---
+NAME: multi_dir_byte_word
+DESCRIPTION: .byte followed by .word on same line
+INPUT:
+ 1: * = $0200
+ 2:   .byte $42 .word $1234
+EXPECT_HEX: 42 34 12
+
+---
+NAME: multi_dir_word_byte
+DESCRIPTION: .word followed by .byte on same line
+INPUT:
+ 1: * = $0200
+ 2:   .word $1234 .byte $56
+EXPECT_HEX: 34 12 56
+
+---
+NAME: multi_dir_three_bytes
+DESCRIPTION: Three .byte directives on one line
+INPUT:
+ 1: * = $0200
+ 2:   .byte $01 .byte $02 .byte $03
+EXPECT_HEX: 01 02 03
+
+---
+NAME: multi_dir_comma_then_directive
+DESCRIPTION: Comma-separated values followed by another directive
+INPUT:
+ 1: * = $0200
+ 2:   .byte $01, $02 .word $0304
+EXPECT_HEX: 01 02 04 03
+
+---
+NAME: multi_dir_asciiz_asciiz
+DESCRIPTION: Two .asciiz directives on one line
+INPUT:
+ 1: * = $0200
+ 2:   .asciiz "A" .asciiz "B"
+EXPECT_HEX: 41 00 42 00
+
+---
+NAME: multi_dir_byte_asciiz
+DESCRIPTION: .byte followed by .asciiz on same line
+INPUT:
+ 1: * = $0200
+ 2:   .byte $42 .asciiz "Hi"
+EXPECT_HEX: 42 48 69 00
+
+---
+NAME: multi_dir_with_label
+DESCRIPTION: Label prefix with multiple directives on same line
+INPUT:
+ 1: * = $0200
+ 2: data: .byte $01 .word $0203
+EXPECT_HEX: 01 03 02
+
+---
+NAME: multi_dir_forward_ref
+DESCRIPTION: Forward reference in second directive on same line
+INPUT:
+ 1: * = $0200
+ 2:   .byte $01 .word target
+ 3: target:
+ 4:   NOP
+EXPECT_HEX: 01 03 02 ea
+
+---
+NAME: zeropage_multi_byte_word
+DESCRIPTION: Multiple zeropage allocations on one line (.byte .word)
+INPUT:
+ 1:   .zeropage
+ 2: a: .byte .word
+ 3: b: .byte
+ 4:   .code
+ 5: * = $0200
+ 6:   LDA a
+ 7:   LDA b
+EXPECT_HEX: a5 00 a5 03
+
+---
+NAME: zeropage_multi_word_byte
+DESCRIPTION: Multiple zeropage allocations on one line (.word .byte)
+INPUT:
+ 1:   .zeropage
+ 2: a: .word .byte
+ 3: b: .byte
+ 4:   .code
+ 5: * = $0200
+ 6:   LDA a
+ 7:   LDA b
+EXPECT_HEX: a5 00 a5 03
+
+---
+NAME: zeropage_multi_three
+DESCRIPTION: Three zeropage allocations on one line
+INPUT:
+ 1:   .zeropage
+ 2: a: .byte .byte .word
+ 3: b: .byte
+ 4:   .code
+ 5: * = $0200
+ 6:   LDA a
+ 7:   LDA b
+EXPECT_HEX: a5 00 a5 04
