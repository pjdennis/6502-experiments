const ubyte TK_COMMA  = 14
const ubyte TK_LBRACK = 15
const ubyte TK_RBRACK = 16
const ubyte TK_AT     = 17
const ubyte TK_LBRACE = 18
const ubyte TK_RBRACE = 19
